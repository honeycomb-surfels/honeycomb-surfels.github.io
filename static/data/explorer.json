  "families": [
    {
      "id": "ours",
      "label": "Hexels",
      "members": [
        "ours_v3",
        "ours_v2"
      ],
      "always": true,
      "description": "Our hexagonal surfels, with color stored on each primitive: V3 (densified) is the quality-oriented configuration and V2 (fixed population) the compact alternative."
    },
    {
      "id": "surface",
      "label": "Surface primitives with local appearance",
      "members": [
        "2dgs",
        "triangle",
        "meshsplatting"
      ],
      "default_visible": true,
      "description": "The paper's closest comparison to Hexels: color is stored on the primitives or mesh vertices, without separate texture maps or neural appearance fields."
    },
    {
      "id": "textured",
      "label": "Textured/neural surfels",
      "members": [
        "bbsplat",
        "nexels"
      ],
      "default_visible": false,
      "description": "Planar primitives colored by separate texture maps (BBSplat, one texture per billboard) or by a shared neural appearance field (Nexels)."
    },
    {
      "id": "volumetric",
      "label": "Volumetric primitives",
      "members": [
        "3dgs",
        "3dconvex"
      ],
      "default_visible": false,
      "description": "3D Gaussians (3DGS) and smooth convex shapes (3D Convex Splatting) that fill a volume instead of lying on a surface."
    }
  ],
