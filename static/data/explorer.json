  "definitions": {
    "memory_mb": "Model memory: every value the renderer reads to draw a view (geometry, appearance, textures, network weights and mesh connectivity), at 4 bytes per value, in MB.",
    "vram_gib": "Peak training VRAM: the most GPU memory used during training, in GiB.",
    "train_min": "Training time: wall-clock minutes per scene, start-up and saving included.",
    "quality": "Quality: PSNR, SSIM and LPIPS (VGG) on the held-out test views (every eighth image), the same for every method.",
    "fps": "Rendering speed: frames per second of rendering alone, with the model on the GPU.",
    "primitives": "Primitives: final number of primitives, each method counting its own kind.",
    "scenes": "Number of scenes averaged.",
    "ada_scenes": "Mixed hardware (†): some runs of this method used an RTX 6000 Ada instead of an RTX A5000.",
    "mean3": "Average of the three dataset means."
  },
  "notes": [
    "Hexels V3 (densified) grows up to 2M primitives; Hexels V2 keeps its initial population. Baselines use their authors' settings.",
    "† Mixed hardware: Triangle Splatting and 3D Convex Splatting ran some scenes on an RTX 6000 Ada (48 GB) after running out of memory on the 24 GB RTX A5000, so their time, FPS and VRAM there are not hardware-matched."
  ]
}
